{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/emmz-makes-stuff/sql-mcp/main/src/SqlMcp/schema/config.schema.json",
  "title": "sql-mcp configuration",
  "description": "User-level (~/.config/sql-mcp/config.json) or project-level (.sql-mcp/config.json) configuration for sql-mcp.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "defaults": {
      "description": "Grants and limits applied to every database in this file, before per-database settings.",
      "$ref": "#/$defs/grants"
    },
    "databases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/database"
      }
    }
  },
  "$defs": {
    "group": {
      "enum": ["query", "introspection", "command", "ddl", "execute"]
    },
    "groupList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      },
      "uniqueItems": true
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxRows": {
          "description": "Most rows buffered for one query. Default 1000.",
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "maxBytes": {
          "description": "Most bytes buffered for one query. Default 5242880 (5 MB), at most 1073741824 (1 GiB).",
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "pageSize": {
          "description": "Rows per page. Default 100.",
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "timeoutSeconds": {
          "description": "Command timeout in seconds. Default 30.",
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "maxAffectedRows": {
          "description": "Most rows one write batch may affect before it is rolled back. Default 1000. It counts the row counts the server reports, so TRUNCATE TABLE and DROP, which report none, aren't limited by it.",
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    "grants": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": {
          "$ref": "#/$defs/groupList"
        },
        "deny": {
          "$ref": "#/$defs/groupList"
        },
        "limits": {
          "$ref": "#/$defs/limits"
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connectionString"],
      "properties": {
        "connectionString": {
          "description": "SQL Server connection string. May reference environment variables as ${env:NAME}.",
          "type": "string",
          "minLength": 1
        },
        "engine": {
          "enum": ["sqlserver"],
          "default": "sqlserver"
        },
        "allow": {
          "$ref": "#/$defs/groupList"
        },
        "deny": {
          "$ref": "#/$defs/groupList"
        },
        "limits": {
          "$ref": "#/$defs/limits"
        }
      }
    }
  }
}
